HEDGEDOC_VERSION=latest
HEDGEDOC_APP_ROOT=/opt/persistent-storage/hedgedoc/app
HEDGEDOC_HTTP_PORT=3000
CMD_DOMAIN=localhost
CMD_URL_ADDPORT=true
#CMD_PROTOCOL_USESSL=true
CMD_ALLOW_EMAIL_REGISTER=true
CMD_CSP_ENABLE=true
CMD_COOKIEPOLICY=lax
CMD_EMAIL=true
#CMD_HSTS_ENABLE=true
#CMD_SAML_ISSUER=
#CMD_SAML_IDPSSOURL=
#CMD_SAML_IDPCERT=/hedgedoc/saml/idpCert.pem
#CMD_SAML_ATTRIBUTE_ID=
#CMD_SAML_ATTRIBUTE_USERNAME=
#CMD_SAML_ATTRIBUTE_EMAIL=
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=14
POSTGRES_APP_ROOT=/opt/persistent-storage/hedgedoc/postgres
POSTGRES_USER=hedgedoc
POSTGRES_PASSWORD=hedgedoc
POSTGRES_DB=hedgedoc
CMD_DB_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres/${POSTGRES_DB}
USER_UID=1000
USER_GID=1000
