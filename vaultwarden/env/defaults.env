VAULTWARDEN_VERSION=latest
VAULTWARDEN_APP_ROOT=/opt/persistent-storage/vaultwarden/app
VAULTWARDEN_HTTP_PORT=8080
DOMAIN=https://vaultwarden.example.com
SIGNUPS_ALLOWED=true
POSTGRES_IMAGE=postgres
POSTGRES_VERSION=18
POSTGRES_APP_ROOT=/opt/persistent-storage/vaultwarden/postgres
POSTGRES_USER=vaultwarden
POSTGRES_PASSWORD=vaultwarden
POSTGRES_DB=vaultwarden
DATABASE_URL=postgresql://${POSTGRES_USER:-vaultwarden}:${POSTGRES_PASSWORD:-vaultwarden}@postgres:5432/${POSTGRES_DB:-vaultwarden}?application_name=vaultwarden&options=-c%20search_path%3Ddb_schema
USER_UID=1000
USER_GID=1000
